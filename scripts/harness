#!/usr/bin/env bash
# Test harness: fixtures, a private X display and session bus, and calls the
# way Nautilus makes them. Nothing here touches the real display or bus.
#
#   harness fixtures                 make the test files
#   harness display                  start Xvfb (3840x2160, Xft.dpi 163), print its DISPLAY
#   harness bus BINARY -- CMD...     run CMD on a private session bus where
#                                    org.gnome.NautilusPreviewer activates BINARY
#   harness show FILE [CLOSE]        ShowFile, as Nautilus calls it (inside `bus`)
#   harness close                    Close (inside `bus`)
#   harness shot NAME                screenshot of the test display
#   harness cold BINARY FILE [N] [NEXT]
#                                    N cold D-Bus activations of BINARY showing FILE, timed
#                                    from the call to the first frame; with NEXT, also the
#                                    switch to NEXT in the open window (arrow browsing)
set -euo pipefail

SCRATCH=${SILENT_SCRATCH:-$HOME/.cache/claude-scratch/silent}
REPO=$(cd "$(dirname "$0")/.." && pwd)
FIXTURES=${SILENT_FIXTURES:-$SCRATCH/fixtures}
NAME=org.gnome.NautilusPreviewer
OBJECT=/org/gnome/NautilusPreviewer
IFACE=org.gnome.NautilusPreviewer2
# Every heavy step runs capped: an endless filter graph once filled RAM.
HEAVY=(systemd-run --user --scope -q -p MemoryMax=4G -p MemorySwapMax=0 nice -n 19 taskset -c 1-15)

die() { echo "harness: $*" >&2; exit 1; }

fixtures() {
    local f=$FIXTURES
    mkdir -p "$f"/{images,video,audio,docs,office,text,archives,compressed,folder,other}
    cd "$f"
    local ff=("${HEAVY[@]}" ffmpeg -nostdin -hide_banner -loglevel error -y)
    local mk=("${HEAVY[@]}" magick)

    # Photos: smooth colour fields with grain compress like real photos.
    "${ff[@]}" -f lavfi -i "gradients=s=4032x3024:n=6:seed=7:d=1" -vf "noise=alls=12:allf=t" \
        -frames:v 1 -q:v 3 images/photo-4032x3024.jpg
    cp images/photo-4032x3024.jpg images/portrait-exif6.jpg
    exiftool -q -overwrite_original -Orientation#=6 -n images/portrait-exif6.jpg
    "${ff[@]}" -f lavfi -i "gradients=s=3840x2160:n=4:seed=3:d=1" -vf "noise=alls=6:allf=t" \
        -frames:v 1 images/uhd-3840x2160.png
    "${ff[@]}" -f lavfi -i "testsrc2=s=1920x1080:d=1" -frames:v 1 -q:v 2 images/fhd-1920x1080.jpg
    "${ff[@]}" -f lavfi -i "smptehdbars=s=1024x768:d=1" -frames:v 1 images/xga-1024x768.png
    "${ff[@]}" -f lavfi -i "mandelbrot=s=640x480" -frames:v 1 -q:v 2 images/vga-640x480.jpg
    "${ff[@]}" -f lavfi -i "testsrc=s=300x200:d=1" -frames:v 1 images/small-300x200.png
    "${ff[@]}" -f lavfi -i "gradients=s=8000x1500:n=3:seed=11:d=1" -frames:v 1 -q:v 3 images/panorama-8000x1500.jpg
    "${ff[@]}" -f lavfi -i "testsrc2=s=1080x6000:d=1" -frames:v 1 images/tall-1080x6000.png
    "${mk[@]}" -size 16x16 xc:none -fill '#d9643a' -draw 'rectangle 3,3 12,12' \
        -fill '#f6e7c8' -draw 'point 6,6 point 9,6 point 6,9 point 7,10 point 8,10 point 9,9' images/icon-16.png
    "${mk[@]}" images/icon-16.png -filter point -resize 400% images/icon-64.png
    "${mk[@]}" -size 900x600 radial-gradient:'#e8a87c'-none images/transparent.png
    # For the strip's colours: a pale picture, a dark one, and a busy one.
    "${ff[@]}" -f lavfi -i "gradients=s=2400x1600:c0=0xf6efe2:c1=0xfffbf3:c2=0xeee3cf:n=3:seed=5:d=1" \
        -frames:v 1 -q:v 3 images/pale-2400x1600.jpg
    "${ff[@]}" -f lavfi -i "gradients=s=2400x1600:c0=0x0b0f1a:c1=0x1d2433:c2=0x05070c:n=3:seed=9:d=1" \
        -frames:v 1 -q:v 3 images/night-2400x1600.jpg
    "${ff[@]}" -t 1 -f lavfi -i "mandelbrot=s=2400x1600:start_scale=0.12:end_scale=0.12:outer=normalized_iteration_count" \
        -vf "noise=alls=20:allf=t" -frames:v 1 -q:v 3 images/busy-2400x1600.jpg
    "${mk[@]}" images/fhd-1920x1080.jpg -quality 60 images/photo.heic
    "${mk[@]}" images/fhd-1920x1080.jpg -quality 60 images/photo.avif
    "${mk[@]}" images/fhd-1920x1080.jpg -quality 80 images/photo.jxl
    "${mk[@]}" images/fhd-1920x1080.jpg -quality 80 images/photo.webp
    "${ff[@]}" -f lavfi -i "testsrc=s=480x360:r=12:d=3" -vf "split[a][b];[a]palettegen[p];[b][p]paletteuse" \
        -loop 0 images/animated.gif
    "${ff[@]}" -f lavfi -i "testsrc=s=480x360:r=12:d=3" -loop 0 -c:v libwebp_anim images/animated.webp
    "${ff[@]}" -f lavfi -i "testsrc=s=320x240:r=10:d=2" -plays 0 -f apng images/animated.png
    cat > images/vector.svg <<'SVG'
<svg xmlns="http://www.w3.org/2000/svg" width="160" height="120" viewBox="0 0 160 120">
  <rect width="160" height="120" fill="#f6efe3"/>
  <circle cx="58" cy="60" r="34" fill="#d9643a"/>
  <rect x="84" y="30" width="52" height="60" rx="8" fill="#5b7f6b"/>
  <text x="80" y="112" font-family="sans-serif" font-size="11" text-anchor="middle" fill="#3b2f25">silent</text>
</svg>
SVG

    # Video: 1080p60 and 4K60 for the frame-rate checks, a small webm, a portrait clip.
    "${ff[@]}" -f lavfi -i "testsrc2=s=1920x1080:r=60:d=10" -f lavfi -i "sine=f=440:d=10" \
        -c:v libx264 -preset veryfast -pix_fmt yuv420p -c:a aac -shortest video/clip-1080p60.mp4
    "${ff[@]}" -f lavfi -i "testsrc2=s=3840x2160:r=60:d=10" \
        -c:v libx264 -preset ultrafast -pix_fmt yuv420p video/clip-4k60.mp4
    "${ff[@]}" -f lavfi -i "testsrc=s=1280x720:r=30:d=6" -f lavfi -i "sine=f=330:d=6" \
        -c:v libvpx-vp9 -deadline realtime -cpu-used 8 -c:a libopus -shortest video/clip-720p.webm
    "${ff[@]}" -f lavfi -i "testsrc2=s=1080x1920:r=30:d=4" \
        -c:v libx264 -preset veryfast -pix_fmt yuv420p video/portrait-1080x1920.mp4

    # Audio: tags and a cover, and one without either.
    "${mk[@]}" -size 600x600 gradient:'#e8a87c'-'#5b7f6b' audio/cover.jpg
    "${ff[@]}" -f lavfi -i "sine=f=262:d=20" -i audio/cover.jpg -map 0 -map 1 -c:a libmp3lame -q:a 4 \
        -c:v copy -id3v2_version 3 -disposition:v attached_pic \
        -metadata title="Quiet Morning" -metadata artist="The Placeholders" -metadata album="Fixtures" \
        audio/song.mp3
    "${ff[@]}" -f lavfi -i "sine=f=392:d=20" -i audio/cover.jpg -map 0 -map 1 -c:a flac \
        -c:v copy -disposition:v attached_pic \
        -metadata title="長い午後" -metadata artist="示例乐队" -metadata album="样本" audio/song.flac
    "${ff[@]}" -f lavfi -i "sine=f=523:d=8" -c:a libvorbis audio/tone.ogg
    rm audio/cover.jpg

    # Documents: real typeset PDFs and a scanned-looking one.
    cp /usr/share/doc/graphviz/dotguide.pdf docs/dotguide.pdf
    cp /usr/share/doc/ghostscript/GS9_Color_Management.pdf docs/color-management.pdf
    "${mk[@]}" images/fhd-1920x1080.jpg images/xga-1024x768.png images/vga-640x480.jpg docs/pictures.pdf

    # Text and code.
    cp "$REPO/src/geometry.rs" text/geometry.rs
    printf 'import sys\n\n\ndef main():\n    print("hello", sys.argv[1:])\n\n\nif __name__ == "__main__":\n    main()\n' > text/script.py
    printf '{\n  "name": "silent",\n  "formats": ["image", "video", "pdf"],\n  "fast": true\n}\n' > text/data.json
    printf 'Notes without an extension.\nSecond line.\n' > text/README
    (yes 'The quick brown fox jumps over the lazy dog, again and again and again.' || true) | head -c 5000000 > text/long.txt
    printf '静夜思\n床前明月光，疑是地上霜。\n举头望明月，低头思故乡。\n' | iconv -f UTF-8 -t GB18030 > text/chinese-gb18030.txt
    printf '静夜思\n床前明月光，疑是地上霜。\n' | iconv -f UTF-8 -t GB18030 > text/chinese-gbk-noext
    printf 'package main\n\nimport "fmt"\n\nfunc main() {\n\tfor i := 0; i < 3; i++ {\n\t\tfmt.Println("tab\tinside", i)\n\t}\n}\n' > text/tabs.go
    for _ in $(seq 220); do cat "$REPO/src/geometry.rs"; done > text/big.rs
    python3 -I - "$f" <<'PY'
import json, random, sys
random.seed(7)
root = sys.argv[1]
stages = ["Gone Fission Hydroplant", "Sockeye Station", "Spawning Grounds", "Marooner's Bay"]
def record(i):
    return {"id": f"{i:08x}-5aea-488a-967d-6f5a6c236579", "url": f"https://stat.ink/@player/salmon3/{i}",
            "stage": {"key": "stage%d" % (i % 4), "name": {"en_US": stages[i % 4], "ja_JP": "ステージ"}},
            "danger_rate": random.randint(60, 333), "clear_waves": random.randint(0, 3),
            "waves": [{"wave": w, "golden_quota": 20 + w, "golden_delivered": random.randint(10, 40)} for w in range(1, 4)],
            "players": [{"name": f"p{j}", "weapons": ["splattershot", "jet squelcher"], "rescue": random.randint(0, 5)} for j in range(4)]}
with open(f"{root}/text/data.min.json", "w") as out:
    json.dump({"records": [record(i) for i in range(40)]}, out, separators=(",", ":"))
with open(f"{root}/compressed/statink.json", "w") as out:
    for i in range(6000):
        out.write(json.dumps(record(i), separators=(",", ":"), ensure_ascii=False) + "\n")
with open(f"{root}/text/minified.js", "w") as out:
    out.write(";".join(f"function f{i}(a,b){{return a*{i}+b}}" for i in range(12000)) + "\n")
PY

    # Archives.
    mkdir -p folder/project/{src,docs,assets}
    cp text/geometry.rs text/script.py folder/project/src/
    cp text/data.json text/README folder/project/
    cp docs/pictures.pdf folder/project/docs/
    cp images/small-300x200.png images/icon-64.png folder/project/assets/
    (cd folder && "${HEAVY[@]}" zip -qr ../archives/project.zip project && "${HEAVY[@]}" tar czf ../archives/project.tar.gz project)
    "${HEAVY[@]}" tar czf archives/many-files.tar.gz -C /usr/share/icons hicolor

    # Single compressed files: text, JSON Lines, a tar without .tar in its name, a program.
    gzip -kc text/long.txt > compressed/long.txt.gz
    "${HEAVY[@]}" gzip -9f compressed/statink.json
    xz -kc text/long.txt > compressed/long.txt.xz
    zstd -qc text/big.rs > compressed/big.rs.zst
    bzip2 -kc text/geometry.rs > compressed/geometry.rs.bz2
    lz4 -qc --content-size text/data.min.json > compressed/data.min.json.lz4
    cp archives/project.tar.gz compressed/project-tar.gz
    gzip -c /usr/bin/true > compressed/program.gz

    # Office, OpenDocument and iWork files, from python-docx, openpyxl, python-pptx,
    # xlwt and odfpy in a venv of the harness's own. iWork packages are made as
    # what a previewer reads of them: preview pictures in a zip.
    local venv=$SCRATCH/venv
    if [[ ! -x $venv/bin/python ]]; then
        python3 -m venv "$venv"
        "${HEAVY[@]}" "$venv/bin/pip" install -q python-docx openpyxl python-pptx odfpy Pillow xlwt
    fi
    "${HEAVY[@]}" "$venv/bin/python" -I - "$f" <<'PY'
import datetime, io, random, sys, zipfile
from PIL import Image, ImageDraw

root = sys.argv[1]
random.seed(11)


def picture(w, h, label, colors=("#e8a87c", "#5b7f6b")):
    im = Image.new("RGB", (w, h), colors[0])
    d = ImageDraw.Draw(im)
    for i in range(0, w, 40):
        d.line([(i, 0), (i + h, h)], fill=colors[1], width=8)
    d.rectangle([w // 8, h // 3, w * 7 // 8, h * 2 // 3], fill="#f6efe3")
    d.text((w // 8 + 20, h // 2 - 10), label, fill="#3b2f25")
    out = io.BytesIO()
    im.save(out, "PNG")
    out.seek(0)
    return out


# docx: headings, styled runs, lists, a table, a picture, Chinese.
from docx import Document
from docx.shared import Inches, Pt, RGBColor

doc = Document()
doc.add_heading("Quarterly Notes", 0)
p = doc.add_paragraph("This report has ")
p.add_run("bold").bold = True
p.add_run(", ")
p.add_run("italic").italic = True
p.add_run(", ")
p.add_run("underlined").underline = True
p.add_run(" and ")
r = p.add_run("struck")
r.font.strike = True
p.add_run(" words, and a ")
r = p.add_run("red phrase")
r.font.color.rgb = RGBColor(0xC0, 0x30, 0x20)
p.add_run(" in one paragraph that is long enough to wrap across the column more than once.")
doc.add_heading("Findings", 1)
for text in ["Cold starts stay under a quarter second", "Arrow keys browse in Nautilus", "Documents parse without Office"]:
    doc.add_paragraph(text, style="List Bullet")
doc.add_paragraph("A nested point", style="List Bullet 2")
doc.add_heading("Steps", 2)
for text in ["Open the file", "Press Space", "Read"]:
    doc.add_paragraph(text, style="List Number")
doc.add_heading("Table", 2)
table = doc.add_table(rows=1, cols=4)
table.style = "Table Grid"
for cell, text in zip(table.rows[0].cells, ["Format", "Parser", "Pages", "Notes"]):
    cell.text = text
for row in [("docx", "own", "1", "headings, lists"), ("xlsx", "calamine", "3", "sheets"), ("pptx", "own", "5", "slides")]:
    cells = table.add_row().cells
    for cell, text in zip(cells, row):
        cell.text = text
doc.add_heading("Picture", 2)
doc.add_picture(picture(800, 450, "figure one"), width=Inches(4.5))
doc.add_paragraph("床前明月光，疑是地上霜。举头望明月，低头思故乡。这一段中文用来检查换行和字体回退。")
for i in range(30):
    doc.add_paragraph(f"Paragraph {i + 1}. " + "Lorem ipsum dolor sit amet, consectetur adipiscing elit. " * 3)
doc.save(f"{root}/office/report.docx")

# xlsx: three sheets, numbers, dates, booleans, text, a wide sheet.
from openpyxl import Workbook

wb = Workbook()
ws = wb.active
ws.title = "Sales"
ws.append(["Region", "Units", "Price", "Revenue", "Date", "Shipped", "Note"])
regions = ["North", "South", "East", "West"]
for i in range(1, 200):
    units = random.randint(1, 500)
    price = round(random.uniform(1, 99), 2)
    ws.append([regions[i % 4], units, price, round(units * price, 2), datetime.date(2026, 1, 1) + datetime.timedelta(days=i), i % 3 == 0, "ok" if i % 5 else "late delivery, call back"])
wide = wb.create_sheet("Wide")
for r in range(1, 301):
    wide.append([r * c for c in range(1, 61)])
cn = wb.create_sheet("中文")
cn.append(["名字", "城市", "分数"])
for name, city, score in [("张三", "上海", 91.5), ("李四", "北京", 88), ("王五", "西雅图", 79.25)]:
    cn.append([name, city, score])
wb.save(f"{root}/office/sales.xlsx")

# xls through xlwt.
import xlwt

book = xlwt.Workbook()
sheet = book.add_sheet("Old")
for c, text in enumerate(["Item", "Count", "Ratio"]):
    sheet.write(0, c, text)
for r in range(1, 20):
    sheet.write(r, 0, f"item {r}")
    sheet.write(r, 1, r * 7)
    sheet.write(r, 2, r / 7)
book.save(f"{root}/office/legacy.xls")

# pptx: title, bullets, a picture, a table, a filled shape.
from pptx import Presentation
from pptx.dml.color import RGBColor as PRGB
from pptx.util import Inches as PI, Pt as PPt

prs = Presentation()
prs.slide_width, prs.slide_height = PI(13.333), PI(7.5)
s = prs.slides.add_slide(prs.slide_layouts[0])
s.shapes.title.text = "silent, a previewer"
s.placeholders[1].text = "Borderless · minimal · fast"
s = prs.slides.add_slide(prs.slide_layouts[1])
s.shapes.title.text = "What it shows"
body = s.placeholders[1].text_frame
body.text = "Pictures, video and sound"
for text, level in [("PDF pages and text", 0), ("selectable and copyable", 1), ("Office documents", 0), ("Word, Excel, PowerPoint", 1), ("Keynote previews", 1)]:
    para = body.add_paragraph()
    para.text = text
    para.level = level
s = prs.slides.add_slide(prs.slide_layouts[5])
s.shapes.title.text = "A picture"
s.shapes.add_picture(picture(1200, 675, "slide picture"), PI(1), PI(1.8), width=PI(7))
box = s.shapes.add_textbox(PI(8.5), PI(2.5), PI(4), PI(2))
box.text_frame.text = "Pictures sit where the deck put them."
box.text_frame.word_wrap = True
s = prs.slides.add_slide(prs.slide_layouts[5])
s.shapes.title.text = "A table and a shape"
shape = s.shapes.add_table(4, 3, PI(0.8), PI(1.8), PI(7), PI(3)).table
for r, row in enumerate([("Kind", "Shown as", "Speed"), ("docx", "column", "fast"), ("xlsx", "grid", "fast"), ("pptx", "slides", "fast")]):
    for c, text in enumerate(row):
        shape.cell(r, c).text = text
rect = s.shapes.add_shape(1, PI(8.6), PI(2), PI(3.8), PI(2.4))
rect.fill.solid()
rect.fill.fore_color.rgb = PRGB(0xD9, 0x64, 0x3A)
rect.text_frame.text = "A filled shape with text"
prs.save(f"{root}/office/deck.pptx")

# ODF: text, a sheet, and slides with a thumbnail.
from odf.opendocument import OpenDocumentPresentation, OpenDocumentSpreadsheet, OpenDocumentText
from odf.style import GraphicProperties, MasterPage, PageLayout, PageLayoutProperties, Style, TextProperties
from odf.table import Table, TableCell, TableColumn, TableRow
from odf.text import H, List, ListItem, P, Span
from odf.draw import Frame, Page, TextBox

odt = OpenDocumentText()
bold = Style(name="Bold", family="text")
bold.addElement(TextProperties(fontweight="bold"))
odt.automaticstyles.addElement(bold)
odt.text.addElement(H(outlinelevel=1, text="Meeting notes"))
p = P(text="The plan has a ")
p.addElement(Span(stylename=bold, text="bold decision"))
p.addText(" and the rest is plain text that wraps when the column is narrow enough.")
odt.text.addElement(p)
odt.text.addElement(H(outlinelevel=2, text="Actions"))
lst = List()
for text in ["Write the parser", "Draw the column", "Ship it"]:
    item = ListItem()
    item.addElement(P(text=text))
    lst.addElement(item)
odt.text.addElement(lst)
t = Table(name="T")
t.addElement(TableColumn(numbercolumnsrepeated=2))
for row in [("Who", "What"), ("cjr", "review"), ("agent", "build")]:
    tr = TableRow()
    for text in row:
        tc = TableCell()
        tc.addElement(P(text=text))
        tr.addElement(tc)
    t.addElement(tr)
odt.text.addElement(t)
odt.save(f"{root}/office/notes.odt")

ods = OpenDocumentSpreadsheet()
t = Table(name="Budget")
for row in [("Item", "Cost"), ("Coffee", 12.5), ("Books", 80), ("Rent", 1500)]:
    tr = TableRow()
    for value in row:
        if isinstance(value, str):
            tc = TableCell(valuetype="string")
            tc.addElement(P(text=value))
        else:
            tc = TableCell(valuetype="float", value=value)
            tc.addElement(P(text=str(value)))
        tr.addElement(tc)
    t.addElement(tr)
ods.spreadsheet.addElement(t)
ods.save(f"{root}/office/budget.ods")

odp = OpenDocumentPresentation()
layout = PageLayout(name="Wide")
layout.addElement(PageLayoutProperties(pagewidth="28cm", pageheight="15.75cm", printorientation="landscape"))
odp.automaticstyles.addElement(layout)
master = MasterPage(name="Default", pagelayoutname=layout)
odp.masterstyles.addElement(master)
for n, (title, lines) in enumerate([("Overview", ["One previewer", "Many formats"]), ("Details", ["Thumbnails come from the file", "Text comes from content.xml"])], 1):
    page = Page(name=f"page{n}", masterpagename=master)
    frame = Frame(width="24cm", height="3cm", x="2cm", y="1cm")
    box = TextBox()
    box.addElement(P(text=title))
    frame.addElement(box)
    page.addElement(frame)
    frame = Frame(width="24cm", height="9cm", x="2cm", y="5cm")
    box = TextBox()
    for line in lines:
        box.addElement(P(text=line))
    frame.addElement(box)
    page.addElement(frame)
    odp.presentation.addElement(page)
odp.save(f"{root}/office/slides.odp")
with zipfile.ZipFile(f"{root}/office/slides.odp", "a") as z:
    z.writestr("Thumbnails/thumbnail.png", picture(256, 144, "Overview").getvalue())


# iWork packages: what matters to a previewer is preview.jpg and its smaller siblings.
def iwork(path, label, size):
    with zipfile.ZipFile(path, "w") as z:
        for name, scale in [("preview.jpg", 1), ("preview-web.jpg", 2), ("preview-micro.jpg", 8)]:
            im = Image.open(picture(size[0] // scale, size[1] // scale, label)).convert("RGB")
            out = io.BytesIO()
            im.save(out, "JPEG", quality=85)
            z.writestr(name, out.getvalue())
        z.writestr("Index/Document.iwa", b"\x00" * 64)
        z.writestr("Metadata/Properties.plist", b"<plist/>")


iwork(f"{root}/office/talk.key", "keynote preview", (1920, 1080))
iwork(f"{root}/office/letter.pages", "pages preview", (1240, 1754))
iwork(f"{root}/office/numbers.numbers", "numbers preview", (1600, 1000))

# An Office lock file: named like a deck, but not one.
with open(f"{root}/office/.~lock-deck.pptx", "wb") as out:
    out.write(b"\x03cjr" + b" " * 50)
PY

    # Word 97 and PowerPoint 97 files, written byte by byte: no office suite
    # here writes them. Only what silent reads is in them.
    python3 -I - "$f" <<'PY'
import struct, sys

root = sys.argv[1]
END, FREE, FAT = 0xFFFFFFFE, 0xFFFFFFFF, 0xFFFFFFFD


def ole(path, streams):
    """A compound file with `streams`, each padded past the mini stream's cutoff."""
    names = list(streams)
    datas = [s.ljust(max(len(s), 4096), b"\0") for s in streams.values()]
    datas = [d.ljust((len(d) + 511) // 512 * 512, b"\0") for d in datas]
    dir_sectors = (len(names) + 1 + 3) // 4
    used = dir_sectors + sum(len(d) // 512 for d in datas)
    fat_sectors = 1
    while fat_sectors * 128 < used + fat_sectors:
        fat_sectors += 1
    fat = [FAT] * fat_sectors
    dir_start = len(fat)
    fat += list(range(dir_start + 1, dir_start + dir_sectors)) + [END]
    starts = []
    for d in datas:
        starts.append(len(fat))
        fat += list(range(len(fat) + 1, len(fat) + len(d) // 512)) + [END]
    fat += [FREE] * (fat_sectors * 128 - len(fat))

    def entry(name, kind, child=FREE, right=FREE, start=END, size=0):
        encoded = name.encode("utf-16-le") + b"\0\0"
        return (encoded.ljust(64, b"\0") + struct.pack("<HBB", len(encoded), kind, 1)
                + struct.pack("<III", FREE, right, child) + b"\0" * 36 + struct.pack("<IQ", start, size))

    # The streams in the directory's order: by length, then by capitals.
    order = sorted(range(len(names)), key=lambda i: (len(names[i]), names[i].upper()))
    directory = entry("Root Entry", 5, child=order[0] + 1)
    entries = {}
    for k, i in enumerate(order):
        right = order[k + 1] + 1 if k + 1 < len(order) else FREE
        entries[i] = entry(names[i], 2, right=right, start=starts[i], size=len(streams[names[i]].ljust(4096, b"\0")))
    for i in range(len(names)):
        directory += entries[i]
    directory = directory.ljust(dir_sectors * 512, b"\0")
    difat = [n for n in range(fat_sectors)] + [FREE] * (109 - fat_sectors)
    header = (bytes.fromhex("d0cf11e0a1b11ae1") + b"\0" * 16
              + struct.pack("<HHHHH", 0x3E, 3, 0xFFFE, 9, 6) + b"\0" * 6
              + struct.pack("<IIIIIIIII", 0, fat_sectors, dir_start, 0, 4096, END, 0, END, 0)
              + struct.pack("<109I", *difat))
    with open(path, "wb") as out:
        out.write(header)
        out.write(struct.pack("<%dI" % len(fat), *fat))
        out.write(directory)
        for d in datas:
            out.write(d)


def word_doc(path):
    # Paragraphs: (style, alignment, in-table mark, runs of (text, bold, italic)).
    title, heading, normal = 1, 2, 0
    paras = [
        (title, 1, None, [("Field Notes", False, False)]),
        (normal, 0, None, [("This old Word file has ", False, False), ("bold", True, False),
                           (" and ", False, False), ("italic", False, True), (" words in it.", False, False)]),
        (heading, 0, None, [("Results", False, False)]),
        (normal, 0, None, [("床前明月光，疑是地上霜。举头望明月，低头思故乡。", False, False)]),
    ]
    rows = [["Kind", "Read by", "Pages"], ["doc", "silent", "3"], ["ppt", "silent", "outline"]]
    for row in rows:
        for cell in row:
            paras.append((normal, 0, "cell", [(cell, row is rows[0], False)]))
        paras.append((normal, 0, "row", []))
    for i in range(12):
        paras.append((normal, 0, None, [("Paragraph %d of the old format, read through its piece table." % (i + 1), False, False)]))
    text, runs, marks = "", [], []
    for style, align, table, spans in paras:
        for chunk, bold, italic in spans:
            runs.append((len(text), len(text) + len(chunk), bold, italic))
            text += chunk
        marks.append((len(text), style, align, table))
        text += "\x07" if table else "\r"
    # The Latin head in one byte a character, the rest in UTF-16.
    split = text.index("床")
    head, tail = text[:split], text[split:]
    word = bytearray(0x400)
    head_at = len(word)
    word += head.encode("cp1252")
    tail_at = len(word)
    word += tail.encode("utf-16-le")
    fc = lambda cp: head_at + cp if cp < split else tail_at + 2 * (cp - split)
    width = lambda cp: 1 if cp < split else 2

    def page(entries):
        """A formatted disk page: runs of bytes, each with its properties."""
        out = bytearray(512)
        free = 511
        out[0:4] = struct.pack("<I", entries[0][0])
        for r, (start, end, props, papx) in enumerate(entries):
            out[4 * (r + 1):4 * (r + 2)] = struct.pack("<I", end)
            if papx:
                body = props + (b"\0" if len(props) % 2 else b"")
                free = (free - 2 - len(body)) & ~1
                out[free:free + 2 + len(body)] = bytes([0, len(body) // 2]) + body
                out[4 * (len(entries) + 1) + 13 * r] = free // 2
            elif props:
                free = (free - 1 - len(props)) & ~1
                out[free:free + 1 + len(props)] = bytes([len(props)]) + props
                out[4 * (len(entries) + 1) + r] = free // 2
        out[511] = len(entries)
        return out

    chpx = []
    for start, end, bold, italic in runs:
        sprms = (b"\x35\x08\x01" if bold else b"") + (b"\x36\x08\x01" if italic else b"")
        chpx.append((fc(start), fc(end - 1) + width(end - 1), sprms, False))
    papx, at = [], fc(0)
    for cp, style, align, table in marks:
        sprms = struct.pack("<H", style) + (b"\x03\x24" + bytes([align]) if align else b"")
        if table:
            sprms += b"\x16\x24\x01" + (b"\x17\x24\x01" if table == "row" else b"")
            if table == "row":
                edges = [0, 2600, 5200, 7800]
                tdef = bytes([len(edges) - 1]) + struct.pack("<%dh" % len(edges), *edges)
                sprms += b"\x08\xd6" + struct.pack("<H", len(tdef) + 1) + tdef
        end = fc(cp) + width(cp)
        papx.append((at, end, sprms, True))
        at = end
    def bin_table(entries):
        """The pages for `entries`, laid at the end of the stream, and their bin table."""
        while len(word) % 512:
            word.append(0)
        starts, numbers = [], []
        for i in range(0, len(entries), 10):
            starts.append(entries[i][0])
            numbers.append(len(word) // 512)
            word.extend(page(entries[i:i + 10]))
        starts.append(entries[-1][1])
        return struct.pack("<%dI" % len(starts), *starts) + struct.pack("<%dI" % len(numbers), *numbers)

    chpx_table = bin_table(chpx)
    papx_table = bin_table(papx)
    sepx_at = len(word)
    # A4, with 2.5 cm margins.
    word += struct.pack("<h", 16) + struct.pack("<8H", 0xB01F, 11906, 0xB020, 16838, 0xB021, 1418, 0xB022, 1418)
    table = bytearray()
    places = {}

    def put(index, data):
        places[index] = (len(table), len(data))
        table.extend(data)

    # The style sheet: Normal, Title and heading 1, with the headings' looks.
    def std(sti, name, chpx_sprms, base=0x0FFF):
        out = struct.pack("<HHHHH", sti, 1 | base << 4, 2, 0, 0)
        out += struct.pack("<H", len(name)) + name.encode("utf-16-le") + b"\0\0"
        for upx in (struct.pack("<H", 0), chpx_sprms):
            out += b"\0" * (len(out) % 2) + struct.pack("<H", len(upx)) + upx
        return out
    styles = [std(0, "Normal", struct.pack("<HH", 0x4A43, 21)),
              std(62, "Title", struct.pack("<HH", 0x4A43, 52) + b"\x35\x08\x01", 0),
              std(1, "heading 1", struct.pack("<HH", 0x4A43, 32) + b"\x35\x08\x01", 0)]
    stsh = struct.pack("<HHH", 18, len(styles), 10) + b"\0" * 14
    for s in styles:
        stsh += struct.pack("<H", len(s)) + s
    put(1, stsh)
    put(6, struct.pack("<IIHIHI", 0, len(text), 0, sepx_at, 0, 0))
    put(12, chpx_table)
    put(13, papx_table)
    plc = struct.pack("<III", 0, split, len(text))
    plc += struct.pack("<HIH", 0, (head_at * 2) | 0x40000000, 0) + struct.pack("<HIH", 0, tail_at, 0)
    put(33, b"\x02" + struct.pack("<I", len(plc)) + plc)
    fib = bytearray(struct.pack("<HHHHHH", 0xA5EC, 0xC1, 0, 0x0409, 0, 0) + b"\0" * 20)
    fib += struct.pack("<H", 14) + b"\0" * 28 + struct.pack("<H", 22)
    fib += b"".join(struct.pack("<I", len(text) if i == 3 else 0) for i in range(22))
    fib += struct.pack("<H", 93)
    for i in range(93):
        fib += struct.pack("<II", *places.get(i, (0, 0)))
    word[0:len(fib)] = fib
    ole(path, {"WordDocument": bytes(word), "0Table": bytes(table)})


def record(kind, body, instance=0, container=False):
    head = instance << 4 | (0xF if container else 0)
    return struct.pack("<HHI", head, kind, len(body)) + body


def power_point(path):
    slides = [("A legacy deck", ["Read as an outline", "Titles, then the text"]),
              ("What it keeps", ["Each slide's text", "In the order of the deck", "Without the drawings"]),
              ("中文幻灯片", ["标题和正文", "按顺序显示"])]
    deck = bytearray()
    offsets = {}
    for n, (title, body) in enumerate(slides):
        boxes = record(0x0F9F, struct.pack("<I", 0)) + record(0x0FA0, title.encode("utf-16-le"))
        texts = record(0xF00D, boxes, container=True)
        boxes = record(0x0F9F, struct.pack("<I", 1)) + record(0x0FA0, "\r".join(body).encode("utf-16-le"))
        texts += record(0xF00D, boxes, container=True)
        offsets[2 + n] = len(deck)
        deck += record(0x03EE, record(0x040C, record(0xF002, texts, container=True), container=True), container=True)
    listing = b"".join(record(0x03F3, struct.pack("<IIiII", 2 + n, 0, 0, 256 + n, 0)) for n in range(len(slides)))
    document = record(0x03E9, struct.pack("<ii", 5760, 4320)) + record(0x0FF0, listing, container=True)
    offsets[1] = len(deck)
    deck += record(0x03E8, document, container=True)
    directory_at = len(deck)
    ids = sorted(offsets)
    deck += record(0x1772, struct.pack("<I", len(ids) << 20 | ids[0]) + b"".join(struct.pack("<I", offsets[i]) for i in ids))
    edit_at = len(deck)
    deck += record(0x0FF5, struct.pack("<IHBBIIIIHH", 0, 0, 0, 3, 0, directory_at, 1, len(ids) + 1, 1, 0))
    user = record(0x0FF6, struct.pack("<IIIHHBBH", 20, 0xE391C05F, edit_at, 0, 0x03F4, 3, 0, 0))
    ole(path, {"PowerPoint Document": bytes(deck), "Current User": user})


word_doc(f"{root}/office/old.doc")
power_point(f"{root}/office/old.ppt")
PY

    # Everything else, binaries as hexdumps.
    head -c 300000 /dev/urandom > other/blob.bin
    cp /usr/bin/true other/program
    # Sparse: five gigabytes that take a megabyte of disk.
    head -c 1000000 /dev/urandom > other/disk-5g.img
    truncate -s 5G other/disk-5g.img
    printf 'the end' >> other/disk-5g.img
    cp "$(fc-match -f '%{file}' 'DejaVu Sans')" other/font.ttf 2>/dev/null || true
    echo "fixtures in $f:"
    find "$f" -type f | sort | sed "s|$f/|  |"
}

display() {
    local n=42
    while [[ -e /tmp/.X11-unix/X$n || -e /tmp/.X$n-lock ]]; do n=$((n + 1)); done
    # -noreset: otherwise the server forgets the resources when xrdb disconnects.
    Xvfb ":$n" -screen 0 3840x2160x24 -nolisten tcp -noreset >"$SCRATCH/xvfb-$n.log" 2>&1 &
    for _ in $(seq 50); do [[ -e /tmp/.X11-unix/X$n ]] && break; sleep 0.1; done
    echo "Xft.dpi: 163" | DISPLAY=":$n" xrdb -nocpp -merge
    echo ":$n"
}

bus() {
    local binary=$1; shift
    [[ ${1:-} == -- ]] && shift
    [[ ${DISPLAY:-} == :0* ]] && die "DISPLAY is the real display; start a test one with 'harness display'"
    local dir; dir=$(mktemp -d "$SCRATCH/bus.XXXXXX")
    mkdir -p "$dir/services"
    printf '[D-BUS Service]\nName=%s\nExec=%s\n' "$NAME" "$binary" > "$dir/services/$NAME.service"
    cat > "$dir/session.conf" <<CONF
<!DOCTYPE busconfig PUBLIC "-//freedesktop//DTD D-Bus Bus Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/dbus/1.0/busconfig.dtd">
<busconfig>
  <type>session</type>
  <listen>unix:tmpdir=$dir</listen>
  <auth>EXTERNAL</auth>
  <servicedir>$dir/services</servicedir>
  <policy context="default">
    <allow send_destination="*" eavesdrop="true"/>
    <allow eavesdrop="true"/>
    <allow own="*"/>
  </policy>
</busconfig>
CONF
    # A runtime directory of its own: what silent remembers stays out of the
    # user's, and no audio server is found there.
    mkdir -m 700 "$dir/runtime"
    # Video and sound play into a fakesink: no real audio sink is good enough.
    # Drawing stays on the CPU (lavapipe, Mesa's EGL): the GPU may be training.
    XDG_RUNTIME_DIR=$dir/runtime \
    VK_DRIVER_FILES=/usr/share/vulkan/icd.d/lvp_icd.json \
    __EGL_VENDOR_LIBRARY_FILENAMES=/usr/share/glvnd/egl_vendor.d/50_mesa.json \
    GST_PLUGIN_FEATURE_RANK=${GST_PLUGIN_FEATURE_RANK:-pulsesink:0,pipewiresink:0,alsasink:0,osssink:0,oss4sink:0,jackaudiosink:0,openalsink:0} \
        dbus-run-session --config-file="$dir/session.conf" -- "$@"
}

show() {
    local uri; uri=$(python3 -I -c 'import pathlib,sys; print(pathlib.Path(sys.argv[1]).resolve().as_uri())' "$1")
    gdbus call --session --timeout 10 --dest $NAME --object-path $OBJECT --method $IFACE.ShowFile \
        "$uri" "${SILENT_PARENT:-x11:0}" "${2:-false}" ''
}

close() {
    gdbus call --session --timeout 10 --dest $NAME --object-path $OBJECT --method $IFACE.Close
}

shot() {
    [[ ${DISPLAY:-} == :0* || -z ${DISPLAY:-} ]] && die "no test display"
    import -display "$DISPLAY" -window root "$SCRATCH/$1.png"
    echo "$SCRATCH/$1.png"
}

cold() {
    local binary=$1 file=$2 n=${3:-10} next=${4:-}
    local log; log=$(mktemp "$SCRATCH/cold.XXXXXX.log")
    SILENT_TRACE=1 bus "$binary" -- "$0" cold-runs "$file" "$n" "$log" "$next" 2>"$log"
    rm -f "$log"
}

# Inside `bus`: each run calls ShowFile, waits for the activated process's
# first-frame mark (wall-clock ns) and subtracts the time of the call.
cold-runs() {
    local file=$1 n=$2 log=$3 next=$4 times=() warm=()
    for _ in $(seq "$n"); do
        local before; before=$(grep -c "first frame" "$log" || true)
        local t0; t0=$(date +%s%N)
        show "$file" true >/dev/null
        local mark=""
        for _ in $(seq 200); do
            mark=$(grep "first frame" "$log" | sed -n "$((before + 1))p" || true)
            [[ -n $mark ]] && break; sleep 0.02
        done
        [[ -z $mark ]] && die "no first frame for $file"
        times+=($(( ($(sed -E 's/.* at ([0-9]+) ns.*/\1/' <<<"$mark") - t0) / 1000 )))
        if [[ -n $next ]]; then
            sleep 0.3
            t0=$(date +%s%N)
            show "$next" >/dev/null
            for _ in $(seq 200); do
                mark=$(grep "first frame" "$log" | sed -n "$((before + 2))p" || true)
                [[ -n $mark ]] && break; sleep 0.02
            done
            warm+=($(( ($(sed -E 's/.* at ([0-9]+) ns.*/\1/' <<<"$mark") - t0) / 1000 )))
        fi
        local pid; pid=$(gdbus call --session --dest org.freedesktop.DBus --object-path /org/freedesktop/DBus \
            --method org.freedesktop.DBus.GetConnectionUnixProcessID $NAME | sed -E 's/.*uint32 ([0-9]+).*/\1/')
        [[ -n $pid ]] && echo "rss $(grep VmRSS /proc/"$pid"/status | awk '{print $2}') kB" >&2
        close >/dev/null
        for _ in $(seq 100); do
            local owned; owned=$(gdbus call --session --dest org.freedesktop.DBus --object-path /org/freedesktop/DBus \
                --method org.freedesktop.DBus.NameHasOwner $NAME)
            [[ $owned == *false* ]] && break
            sleep 0.02
        done
        echo "run done" >&2
        sleep 0.2
    done
    report() { printf '%s\n' "${@:2}" | sort -n | awk -v what="$1" '{ v[NR] = $1 } END {
        printf "%s: median %.1f ms, min %.1f, max %.1f (n=%d)\n", what, (NR % 2 ? v[(NR + 1) / 2] : (v[NR / 2] + v[NR / 2 + 1]) / 2) / 1000, v[1] / 1000, v[NR] / 1000, NR }'; }
    report "cold $(basename "$file")" "${times[@]}"
    [[ -n $next ]] && report "warm $(basename "$next")" "${warm[@]}"
    grep "^rss" "$log" | awk '{ s += $2; n++ } END { if (n) printf "rss while shown: %.0f MB (mean of %d)\n", s / n / 1024, n }'
}

cmd=${1:-}; shift || true
case $cmd in
    fixtures | display | bus | show | close | shot | cold | cold-runs) "$cmd" "$@" ;;
    *) sed -n '2,17p' "$0"; exit 2 ;;
esac
